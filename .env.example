# Gemini API key for the judge pipeline
GOOGLE_GEMINI_API=your-gemini-api-key-here

# Optional: S3 presigned URL -> static URL conversion (only if using static_url.py)
AWS_REGION=ap-south-1
S3_SOURCE_BUCKET=your-source-bucket
S3_DEST_BUCKET=your-dest-bucket
S3_UPLOAD_PREFIX=llm_evaluation_framework
S3_DOWNLOAD_PROFILE=your-aws-download-profile
S3_UPLOAD_PROFILE=your-aws-upload-profile
